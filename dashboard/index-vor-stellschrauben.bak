  // Darstellung: Auto folgt dem Betriebssystem, Hell und Dunkel ueberschreiben es.
  // Drei Stufen statt zwei, weil ein reiner Zweiwegschalter die Systemeinstellung
  // unwiderruflich verwirft, sobald man ihn einmal angefasst hat.
  var STUFEN = ['auto', 'light', 'dark'];
  var STUFENNAME = { auto: 'Auto', light: 'Hell', dark: 'Dunkel' };
  var SYMBOL = {
    auto: '<circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.6"/>' +
          '<path d="M8 1.8 A6.2 6.2 0 0 1 8 14.2 Z" fill="currentColor"/>',
    light: '<circle cx="8" cy="8" r="3.1" fill="currentColor"/>' +
           '<path d="M8 .9v2M8 13.1v2M.9 8h2M13.1 8h2M3 3l1.4 1.4M11.6 11.6L13 13M13 3l-1.4 1.4M4.4 11.6L3 13"' +
           ' stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
    dark: '<path d="M13.4 10.6 A5.9 5.9 0 0 1 5.4 2.6 A6.3 6.3 0 1 0 13.4 10.6 Z" fill="currentColor"/>'
  };
  var stufe = (function () {
    try { var v = localStorage.getItem('sk-theme');
          return STUFEN.indexOf(v) >= 0 ? v : 'auto'; } catch (e) { return 'auto'; }
  })();
  function stufeAnwenden(t) {
    var r = document.documentElement;
    if (t === 'auto') r.removeAttribute('data-theme'); else r.setAttribute('data-theme', t);
    try { if (t === 'auto') localStorage.removeItem('sk-theme');
          else localStorage.setItem('sk-theme', t); } catch (e) {}
  }
  stufeAnwenden(stufe);   // vor dem ersten Rendern, sonst blitzt die falsche Fassung auf

  function themeButton() {
    return '<button class="chip theme" id="theme" type="button" aria-live="polite"' +
      ' title="Darstellung: Auto folgt deinem System">' + themeInner() + '</button>';
  }
  function themeInner() {
    return '<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">' + SYMBOL[stufe] +
      '</svg>' + STUFENNAME[stufe];
  }

  // Haeuser, deren Programm noch nicht abgerufen ist, werden mitgezaehlt, aber
  // getrennt ausgewiesen: "9 von 16" sagt die Wahrheit, "16" waere gelogen.
  function kinoZaehler(d, nurKinos) {
    var sichtbar = d.cinemas.filter(function (c) { return !nurKinos.size || nurKinos.has(c.group); });
    var live = sichtbar.filter(function (c) { return c.status !== 'abruf_offen'; }).length;
    return (live === sichtbar.length ? sichtbar.length : live + ' von ' + sichtbar.length) + ' Kinos';
  }

  function badge(cls, txt) { return '<span class="badge ' + cls + '">' + esc(txt) + '</span>'; }

  function timeChip(s, mitDatum) {
    var inner = (mitDatum ? '<span class="d">' + esc(kurz(s.date)) + '</span>' : '') + esc(s.time) +
      (s.version ? '<span class="v">' + esc(s.version) + '</span>' : '');
    var cls = 'time' + (s.nachtrag ? ' nachtrag' : '');
    var tt = s.nachtrag
      ? ' title="Von der Kinoseite belegt am ' + esc(s.nachtrag.belegt_am) +
        ' — kino-zeit führt diese Vorstellung nicht' +
        (s.nachtrag.reihe ? ' (Reihe: ' + esc(s.nachtrag.reihe) + ')' : '') + '"'
      : '';
    return s.booking_url
      ? '<a class="' + cls + '"' + tt + ' href="' + esc(s.booking_url) + '" target="_blank" rel="noopener">' + inner + '</a>'
      : '<span class="' + cls + '"' + tt + '>' + inner + '</span>';
  }

  // Deutsche Kinos wechseln ihr Programm donnerstags. Bis zum naechsten
  // Donnerstag steht jeder Tag einzeln, alles danach kommt unter "ab <Datum>" —
  // dort sind es ohnehin nur noch einzelne Vorverkaufstermine.
  function grenzdatum(dates) {
    for (var i = 1; i < dates.length; i++)
      if (new Date(dates[i] + 'T12:00:00').getDay() === 4) return dates[i];
    return null;
  }

  function trifftDatum(s, sel, grenze) {
    if (sel === 'alle') return true;
    if (sel === 'ab') return grenze && s.date >= grenze;
    return s.date === sel;
  }

  function render(d, state) {
    var grenze = grenzdatum(d.dates);
    var sel = state.sel, nurKinos = state.kinos;
    var cinemas = {}; d.cinemas.forEach(function (c) { cinemas[c.id] = c; });
    var gruppeVon = {};
    d.cinemas.forEach(function (c) { gruppeVon[c.id] = c.group; });
    var imFilter = function (cid) { return !nurKinos.size || nurKinos.has(gruppeVon[cid]); };
    var passt = function (s) { return trifftDatum(s, sel, grenze) && imFilter(s.cinema_id); };

    var shown = d.films.map(function (f) { return { f: f, s: f.showings.filter(passt) }; })
                       .filter(function (x) { return x.s.length; });
    var vorst = shown.reduce(function (n, x) { return n + x.s.length; }, 0);
    var treffer = shown.filter(function (x) { return x.f.match.status === 'treffer'; });
    var unscharf = shown.filter(function (x) { return x.f.match.status === 'unscharf'; });
    var mubi = shown.filter(function (x) { return x.f.mubi_go; });

    // Eine Auswahl gilt nur, solange der Film im aktuellen Ausschnitt laeuft.
    // Wechselt man auf einen Tag ohne diesen Film, faellt sie lautlos weg —
    // sonst staende unten "nur Taxi Driver" ueber einer leeren Liste.
    if (state.film && !shown.some(function (x) { return x.f.key === state.film; })) state.film = null;
    var gewaehlt = state.film;
    var gewaehlterTitel = gewaehlt
      ? (shown.filter(function (x) { return x.f.key === gewaehlt; })[0] || {}).f.title : null;

    var titel = sel === 'alle' ? kurz(d.date_from) + '–' + kurz(d.date_to)
              : sel === 'ab'   ? 'ab ' + kurz(grenze)
              : dayLabel(sel, sel === d.dates[0]);
    var wann = sel === 'alle' ? 'im ganzen Zeitraum'
             : sel === 'ab'   ? 'ab ' + kurz(grenze)
             : (sel === d.dates[0] ? 'heute' : 'an diesem Tag');
    var zeigeDatum = sel === 'alle' || sel === 'ab';

    var h = [];
    h.push('<header class="masthead"><div class="brand">' + LOGO +
      '<div><h1>Schrödingers Kino</h1><p class="tagline">Der Film läuft. Vielleicht. Bis du nachschaust.</p></div></div>' +
      '<div class="whenwhere"><strong>' + esc(titel) + '</strong><br>' +
      esc(d.region || d.city) + ' · ' + kinoZaehler(d, nurKinos) + '<br>' +
      'Watchlist <strong>' + esc(d.watchlist.username) + '</strong> · ' + d.watchlist.total + ' Titel</div>' +
      themeButton() + '</header>');

    h.push('<div class="metrics">' +
      '<div class="metric hit"><span class="num">' + treffer.length + '</span><span class="lbl">Treffer</span></div>' +
      '<div class="metric mubi"><span class="num">' + mubi.length + '</span><span class="lbl">MUBI-GO-Film</span></div>' +
      '<div class="metric"><span class="num">' + vorst + '</span><span class="lbl">Vorstellungen</span></div>' +
      '<div class="metric"><span class="num">' + shown.length + '</span><span class="lbl">Filme im Programm</span></div>' +
      '<div class="metric"><span class="num">' + d.dates.length + '<small> Tage</small></span><span class="lbl">im Fenster</span></div></div>');

    // Datum
    var zaehl = function (pruef) {
      return d.films.reduce(function (a, f) {
        return a + f.showings.filter(function (x) {
          return pruef(x) && imFilter(x.cinema_id); }).length; }, 0);
    };
    var tage = grenze ? d.dates.filter(function (x) { return x < grenze; }) : d.dates;
    h.push('<div class="bar"><span class="lead">Datum</span>' +
      '<button class="chip" data-day="alle" aria-pressed="' + (sel === 'alle') + '">Alle<span class="n">' +
        zaehl(function () { return true; }) + '</span></button>' +
      tage.map(function (dt, i) {
        return '<button class="chip" data-day="' + dt + '" aria-pressed="' + (dt === sel) + '">' +
          esc(dayLabel(dt, i === 0)) + '<span class="n">' +
          zaehl(function (x) { return x.date === dt; }) + '</span></button>';
      }).join('') +
      (grenze ? '<button class="chip" data-day="ab" aria-pressed="' + (sel === 'ab') + '">ab ' +
        esc(kurz(grenze)) + '<span class="n">' +
        zaehl(function (x) { return x.date >= grenze; }) + '</span></button>' : '') +
      '</div>');

    // Kinos, nach Betreibergruppe zusammengefasst
    h.push('<div class="bar tight"><span class="lead">Kinos</span>' +
      '<button class="chip" data-kino="alle" aria-pressed="' + (!nurKinos.size) + '">Alle Kinos</button>' +
      (d.groups || []).map(function (g) {
        var n = d.films.reduce(function (a, f) {
          return a + f.showings.filter(function (x) {
            return g.cinemas.indexOf(x.cinema_id) >= 0 && trifftDatum(x, sel, grenze); }).length; }, 0);
        return '<button class="chip" data-kino="' + g.id + '" aria-pressed="' + nurKinos.has(g.id) + '"' +
          (n ? '' : ' data-leer') + ' title="' + esc(g.cinemas.map(function (id) {
            var c = d.cinemas.filter(function (y) { return y.id === id; })[0];
            return c ? c.name : id; }).join(' · ')) + '">' +
          esc(g.name) + (g.mubi_partner ? ' ●' : '') + '<span class="n">' + n + '</span></button>';
      }).join('') + '</div>');

    // Bei gewaehltem Film die vier Filterchips ersetzen: zwei konkurrierende
    // Filtermechanismen gleichzeitig sichtbar zu lassen, verwirrt mehr als es nuetzt.
    if (gewaehlt) {
      h.push('<div class="bar tight"><span class="lead">Auswahl</span>' +
        '<button class="chip auswahl" data-clear aria-pressed="true">Nur „' + esc(gewaehlterTitel) +
        '\u201c<span class="x" aria-hidden="true">×</span></button>' +
        '<span class="note">Das Programm unten zeigt nur diesen Film.</span></div>');
    } else {
      h.push('<div class="bar tight"><span class="lead">Filter</span>' +
        '<button class="chip" data-filter="all" aria-pressed="true">Alles zeigen</button>' +
        '<button class="chip" data-filter="watchlist" aria-pressed="false">Nur Watchlist</button>' +
        '<button class="chip" data-filter="mubi" aria-pressed="false">Nur MUBI GO</button>' +
        '<button class="chip" data-filter="ov" aria-pressed="false">Nur OmU / OV</button></div>');
    }

    h.push('<div class="legend">' +
      '<span>' + badge('b-watch','Watchlist') + ' steht auf deiner Letterboxd-Liste</span>' +
      '<span>' + badge('b-mubi','MUBI GO') + ' Ticket über MUBI GO einlösbar</span>' +
      '<span>● MUBI-GO-Partnerkino</span>' +
      '<span><span class="probe-nachtrag"></span> von der Kinoseite belegt, fehlt bei kino-zeit</span></div>');

    var cards = treffer.concat(unscharf);
    h.push('<section><div class="sec-head"><h2>Deine Treffer</h2><span class="note">' +
      (cards.length ? 'Filme von deiner Watchlist, die ' + wann + ' laufen' : 'hier läuft nichts von deiner Liste') +
      '</span></div>');
    if (cards.length) {
      h.push('<div class="hits">' + cards.map(function (x) {
        var f = x.f, m = f.match, w = m.watchlist;
        var orte = [...new Set(x.s.map(function (s) { return cinemas[s.cinema_id].name; }))];
        var zeiten = zeigeDatum
          ? (x.s.length === 1 ? kurz(x.s[0].date) + ' ' + x.s[0].time
             : x.s.length + ' Vorstellungen, ' + kurz(x.s[0].date) + '–' + kurz(x.s[x.s.length-1].date))
          : x.s.map(function (s) { return s.time + (s.version ? ' ' + s.version : ''); }).join(' · ');
        var nurNachtrag = x.s.length && x.s.every(function (s) { return s.nachtrag; });
        var why = m.status === 'treffer'
          ? 'Auf der Watchlist seit ' + esc(w.added_on) + (f.mubi_go ? '. Aktueller MUBI-GO-Film — Ticket kostenlos.' : '.') +
            (nurNachtrag ? ' Termin von der Kinoseite belegt — kino-zeit führt ihn nicht.' : '')
          : 'Möglicher Treffer zu „' + esc(w.title) + ' (' + esc(w.year) + ')" bei ' + m.confidence + '. Erst die TMDb-ID entscheidet.';
        var aktiv = f.key === gewaehlt;
        return '<article class="hit-card' + (m.status === 'unscharf' ? ' unscharf' : '') +
          (f.mubi_go ? ' mubi' : '') + (aktiv ? ' gewaehlt' : '') + '"' +
          ' data-film="' + esc(f.key) + '" role="button" tabindex="0"' +
          ' aria-pressed="' + aktiv + '"><div class="badges">' +
          (f.mubi_go ? badge('b-mubi','MUBI GO') : '') +
          (m.status === 'treffer' ? badge('b-watch','Watchlist') : badge('b-quant','unscharf')) +
          (x.s[0].version ? badge('b-plain', x.s[0].version) : '') +
          '</div><h3>' + esc(f.title) + '</h3><div class="where">' + esc(orte.join(' · ')) +
          ' · <strong>' + esc(zeiten) + '</strong></div><div class="why">' + why + '</div>' +
          '<div class="karte-tipp">' + (aktiv ? 'Auswahl aufheben ×' : 'Zeiten unten zeigen →') +
          '</div></article>';
      }).join('') + '</div>');
    } else {
      h.push('<p class="empty-msg">Hier läuft nichts von deiner Liste. Die Katze bleibt in der Kiste.</p>');
    }
    h.push('</section>');

    h.push('<section id="programm"><div class="sec-head"><h2>Kinos &amp; Vorstellungszeiten</h2>' +
      '<span class="note">' + esc(titel) +
      (gewaehlt ? ' — nur „' + esc(gewaehlterTitel) + '\u201c' : ' — Zeiten führen direkt zum Ticket') +
      '</span></div><div id="cinemas">');
    d.cinemas.forEach(function (c) {
      if (!imFilter(c.id)) return;
      if (c.status === 'abruf_offen') {
        // Bei gewaehltem Film waeren sie nur Rauschen — sonst stehen sie da,
        // damit niemand die Region fuer vollstaendig haelt.
        if (gewaehlt) return;
        h.push('<article class="cinema offen"><div class="cinema-head"><h3>' + esc(c.name) + '</h3>' +
          '<span class="addr">' + esc(c.district || c.ort || '') + '</span><span class="right">' +
          '<span class="status"><span class="dot dot-offen"></span>Abruf offen</span></span></div>' +
          '<p class="empty-msg">Programm noch nicht abgerufen — kino-zeit-Knoten ' +
          esc(c.kinozeit_node) + '.</p></article>');
        return;
      }
      var rows = shown.filter(function (x) {
        return (!gewaehlt || x.f.key === gewaehlt) &&
               x.s.some(function (s) { return s.cinema_id === c.id; }); });
      if (!rows.length) return;
      h.push('<article class="cinema" data-cinema><div class="cinema-head"><h3>' + esc(c.name) + '</h3>' +
        '<span class="addr">' + esc(c.district || '') + '</span><span class="right">' +
        (c.mubi_partner ? badge('b-mubi','MUBI GO') : '') +
        '<span class="status"><span class="dot"></span>Programm live</span></span></div>');
      h.push('<ul class="films">' + rows.map(function (x) {
        var f = x.f, st = f.match.status;
        var slots = x.s.filter(function (s) { return s.cinema_id === c.id; });
        if (!slots.length) return '';
        var hasOV = slots.some(function (s) { return s.version && s.version !== 'DF'; });
        var attrs = (st === 'treffer' || st === 'unscharf' ? ' data-watchlist' : '') +
                    (f.mubi_go ? ' data-mubi' : '') + (hasOV ? ' data-ov' : '');
        var sub = [f.genre, f.runtime_min ? f.runtime_min + ' Min' : null,
          zeigeDatum && slots.length > 1 ? slots.length + ' Vorstellungen' : null,
          f.match.related.length ? 'Vorgänger „' + f.match.related[0].title + '" steht auf deiner Watchlist' : null]
          .filter(Boolean).join(' · ');
        return '<li class="film ' + (st === 'treffer' ? 'treffer' : st === 'unscharf' ? 'unscharf' : '') +
          (f.mubi_go ? ' mubigo' : '') +
          (zeigeDatum && slots.length > 3 ? ' stacked' : '') + '"' + attrs + '>' +
          '<div class="title">' + esc(f.title) +
          (f.mubi_go ? badge('b-mubi','MUBI GO') : '') +
          (st === 'treffer' ? badge('b-watch','Watchlist') : '') +
          (st === 'unscharf' ? badge('b-quant','unscharf') : '') + '</div>' +
          '<div class="sub">' + esc(sub) + '</div>' +
          '<div class="times">' + slots.map(function (s) { return timeChip(s, zeigeDatum); }).join('') + '</div></li>';
      }).join('') + '</ul></article>');
    });
    h.push('</div><p id="noresults" class="empty-msg" hidden>In diesem Filter läuft nichts.</p></section>');

    h.push('<div class="banner"><strong>Matching-Stufe ' + esc(d.matching.stufe) + '.</strong> ' +
      esc(d.matching.verfahren) + '. ' + esc(d.matching.grenze) + '</div>');

    h.push('<section><div class="sec-head"><h2>Datenquellen</h2><span class="note">Stand ' +
      esc(new Date(d.generated_at).toLocaleString('de-DE', { dateStyle:'short', timeStyle:'short' })) +
      '</span></div><div class="sources">' + d.sources.map(function (s) {
        return '<div class="src-row"><span class="what">' + esc(s.name) + '</span><span class="how">' +
          esc(String(s.url).replace(/^https?:\/\/(www\.)?/, '').slice(0, 52)) + '</span></div>';
      }).join('') + '</div></section>');

    h.push('<footer><p><strong>Prototyp.</strong> Kinos, Filme und Zeiten kommen direkt von kino-zeit.de; ' +
      'einzelne Vorstellungen können kurzfristig abweichen. Vor der Fahrt in die Stadt beim Kino gegenprüfen.</p>' +
      '<p>MUBI und MUBI GO sind Marken von MUBI, Letterboxd ist eine Marke von Letterboxd Limited. ' +
      'Das Kobaltblau kennzeichnet MUBI-GO-Vorstellungen, das Orange Titel von der Letterboxd-Watchlist.</p></footer>');

    return h.join('');
  }

  function zumProgramm() {
    var z = document.getElementById('programm');
    if (!z) return;
    var sanft = !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    z.scrollIntoView({ behavior: sanft ? 'smooth' : 'auto', block: 'start' });
  }

  function wire(d, state) {
    var app = document.getElementById('app');
    app.innerHTML = render(d, state);

    // Trefferkarte anklicken blendet unten das Programm auf diesen Film ein.
    app.querySelectorAll('[data-film]').forEach(function (el) {
      var waehle = function (vonTastatur) {
        var k = el.getAttribute('data-film');
        state.film = (state.film === k) ? null : k;
        wire(d, state);
        if (vonTastatur) {   // Platz der Tastatur halten, ohne dabei zu springen
          var neu = document.querySelector('[data-film="' + k.replace(/"/g, '\\"') + '"]');
          if (neu) neu.focus({ preventScroll: true });
        }
        if (state.film) zumProgramm();
      };
      el.addEventListener('click', function () { waehle(false); });
      el.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
          e.preventDefault(); waehle(true);
        }
      });
    });
    var loeschen = app.querySelector('[data-clear]');
    if (loeschen) loeschen.addEventListener('click', function () { state.film = null; wire(d, state); });

    var tb = document.getElementById('theme');
    if (tb) tb.addEventListener('click', function () {
      stufe = STUFEN[(STUFEN.indexOf(stufe) + 1) % STUFEN.length];
      stufeAnwenden(stufe);
      tb.innerHTML = themeInner();   // nur der Knopf, damit gesetzte Filter stehen bleiben
    });

    app.querySelectorAll('[data-day]').forEach(function (b) {
      b.addEventListener('click', function () { state.sel = b.getAttribute('data-day'); wire(d, state); });
    });
    app.querySelectorAll('[data-kino]').forEach(function (b) {
      b.addEventListener('click', function () {
        var id = b.getAttribute('data-kino');
        if (id === 'alle') state.kinos.clear();
        else if (state.kinos.has(id)) state.kinos.delete(id);
        else state.kinos.add(id);
        wire(d, state);
      });
    });

    var chips = [].slice.call(app.querySelectorAll('[data-filter]'));
    var films = [].slice.call(app.querySelectorAll('.film'));
    var kinos = [].slice.call(app.querySelectorAll('[data-cinema]'));
    var none = document.getElementById('noresults');
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var mode = chip.getAttribute('data-filter');
        chips.forEach(function (c) { c.setAttribute('aria-pressed', String(c === chip)); });
        var any = false;
        films.forEach(function (f) {
          f.hidden = !(mode === 'all' ||
            (mode === 'watchlist' && f.hasAttribute('data-watchlist')) ||
            (mode === 'mubi' && f.hasAttribute('data-mubi')) ||
            (mode === 'ov' && f.hasAttribute('data-ov')));
        });
        kinos.forEach(function (c) {
          var vis = c.querySelectorAll('.film:not([hidden])').length;
          c.hidden = mode !== 'all' && vis === 0;
          if (!c.hidden) any = true;
        });
        if (none) none.hidden = any;
      });
    });
  }

  function start(d) { wire(d, { sel: d.dates[0], kinos: new Set(), film: null }); }

  if (window.__TODAY__) { start(window.__TODAY__); }
  else {
    fetch('./data/today.json', { cache: 'no-store' })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(start)
      .catch(function (e) {
        document.getElementById('boot').textContent =
          'Spielplan konnte nicht geladen werden (' + e.message + ').'; });
  }
})();
</script>
</body>
</html>
